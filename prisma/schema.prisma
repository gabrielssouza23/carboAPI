generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admins {
  id    String @id
  nome  String @db.VarChar(255)
  email String @db.VarChar(255)
  senha String
}

model contributor {
  id    String @id
  name  String @db.VarChar(255)
  email String @db.VarChar(255)
}

model especies {
  id                    String                  @id @db.VarChar(256)
  nomepopular           String                  @db.VarChar(255)
  nomecientifico        String                  @db.VarChar(255)
  reino                 String                  @db.VarChar(100)
  filo                  String                  @db.VarChar(100)
  classe                String                  @db.VarChar(100)
  ordem                 String                  @db.VarChar(100)
  familia               String                  @db.VarChar(100)
  genero                String                  @db.VarChar(100)
  especie               String                  @db.VarChar(100)
  descricao             String?
  catalogthumb          String?
  speciecontributionimg speciecontributionimg[]
  speciereferences      speciereferences[]
  speciesimage          speciesimage[]
}

model participacoes {
  id           Int       @id @default(autoincrement())
  nome         String    @db.VarChar(100)
  localizacao  String    @db.VarChar(100)
  mensagem     String?
  contato      String?   @db.VarChar(100)
  data_criacao DateTime? @default(now()) @db.Timestamp(6)
}

model speciecontributionimg {
  id        Int       @id @default(autoincrement())
  data      DateTime? @db.Timestamp(6)
  longitude Float?
  latitude  Float?
  exibir    String?   @db.VarChar(10)
  name      String?   @db.VarChar(255)
  email     String?   @db.VarChar(255)
  location  String?   @db.VarChar(255)
  phone     String?   @db.VarChar(255)
  image     String?   @db.VarChar(255)
  specieid  String?
  especies  especies? @relation(fields: [specieid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model speciereferences {
  id        Int       @id @default(autoincrement())
  reference String
  specieid  String?
  especies  especies? @relation(fields: [specieid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_specie")
}

model speciesimage {
  id           Int       @id @default(autoincrement())
  specieid     String?
  speciesimage String?
  especies     especies? @relation(fields: [specieid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
